doctype html
html(lang="ru")
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(href=assetPath('main.css') rel="stylesheet")
  body.flex.min-h-screen.flex-col.bg-gray-50.text-gray-900
    nav.border-b.border-gray-200.bg-white
      .mx-auto.flex.max-w-5xl.flex-wrap.items-center.justify-between.gap-4.px-4.py-3
        a.text-lg.font-semibold(href="/")= "Главная"
        .flex.gap-4
          a(class="text-sm text-gray-600 hover:text-gray-900" href=route('users'))= "Пользователи"
          a(class="text-sm text-gray-600 hover:text-gray-900" href=route('courses'))= "Курсы"

    .mx-auto.w-full.max-w-5xl.flex-1.px-4.pb-10
      if flash && flash.warning
        for message in flash.warning
          .mt-4.rounded.border.border-amber-200.bg-amber-50.px-4.py-3.text-amber-800= message

      if flash && flash.success
        for message in flash.success
          .mt-4.rounded.border.border-green-200.bg-green-50.px-4.py-3.text-green-800= message

      if flash && flash.info
        for message in flash.info
          .mt-4.rounded.border.border-sky-200.bg-sky-50.px-4.py-3.text-sky-800= message

      h1.mt-6.mb-4.text-3xl.font-bold
        block header
      block content

    footer.bg-gray-800.text-gray-100
      .mx-auto.max-w-5xl.px-4.py-4
        p.mb-0 &copy; Hexlet Ltd, 2024
