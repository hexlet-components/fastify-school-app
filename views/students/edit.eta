<% layout("../layouts/index", { header: "Редактирование студента" }) %>
<div class="mx-auto max-w-xl rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <form action="<%= it.route('student', { id: it.student.id }) %>?_method=PATCH" method="post">
    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="name">Имя</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="name" name="name" value="<%= it.student.name %>">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="email">Email</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="email" name="email" value="<%= it.student.email %>">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="birthYear">Год рождения</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="birthYear" name="birthYear" value="<%= it.student.birth_year %>">
    </div>

    <input class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type="submit" value="Сохранить">
  </form>
</div>
