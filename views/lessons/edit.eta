<% layout("../layouts/index", { header: "Редактирование урока" }) %>
<div class="mx-auto max-w-xl rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <form action="<%= it.route('lesson', { id: it.lesson.id }) %>?_method=PATCH" method="post">
    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="title">Название</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="title" name="title" value="<%= it.lesson.title %>">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="content">Текст урока</label>
      <textarea class="w-full rounded border border-gray-300 px-3 py-2" id="content" name="content" rows="8"><%= it.lesson.content %></textarea>
    </div>

    <input class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type="submit" value="Сохранить">
  </form>
</div>
