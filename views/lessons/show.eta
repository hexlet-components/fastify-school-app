<% layout("../layouts/index", { header: it.lesson.title }) %>
<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <dl>
    <div class="mb-3 flex flex-wrap gap-2">
      <dt class="text-gray-500">Название</dt>
      <dd><%= it.lesson.title %></dd>
    </div>
    <div class="mb-4 flex flex-wrap gap-2">
      <dt class="text-gray-500">Текст урока</dt>
      <dd class="whitespace-pre-line"><%= it.lesson.content %></dd>
    </div>
  </dl>
  <div class="flex flex-wrap items-center gap-2">
    <a class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" href="<%= it.route('editLesson', { id: it.lesson.id }) %>">Редактировать</a>
    <form action="<%= it.route('lesson', { id: it.lesson.id }) %>?_method=DELETE" method="post">
      <input class="cursor-pointer rounded bg-red-600 px-4 py-2 text-white hover:bg-red-700" type="submit" value="Удалить">
    </form>
  </div>
</div>
