<% layout("../layouts/index", { header: "Редактирование преподавателя" }) %>
<div class="mx-auto max-w-xl rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <form action="<%= it.route('teacher', { id: it.teacher.id }) %>?_method=PATCH" method="post">
    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="name">Имя</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="name" name="name" value="<%= it.teacher.name %>">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="email">Email</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="email" name="email" type="email" value="<%= it.teacher.email %>">
    </div>

    <input class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type="submit" value="Сохранить">
  </form>
</div>
