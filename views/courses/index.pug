extends ../layouts/index.pug

block header
  = "Список курсов"

block content
  a(class="inline-block rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" href=route('newCourse')) Новый курс

  .mt-6.rounded-lg.border.border-gray-200.bg-white.p-6.shadow-sm
    form(action=route('courses') method='get')
      .flex.flex-wrap.items-end.gap-4
        div.flex-1
          label.mb-1.block.text-sm.font-medium(for='filterTitle') Название курса
          input(class="w-full rounded border border-gray-300 px-3 py-2" id='filterTitle' name='title')
        input(class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type='submit' value='Поиск')

  .mt-8.overflow-x-auto
    table.w-full.border-collapse.bg-white.text-left
      thead
        tr.border-b.border-gray-200
          th.px-4.py-2.font-semibold Идентификатор
          th.px-4.py-2.font-semibold Название
          th.px-4.py-2.font-semibold Действия
      tbody
        each course in courses
          tr(class="border-b border-gray-100 odd:bg-gray-50")
            td.px-4.py-2= course.id
            td.px-4.py-2
              a(class="text-blue-600 hover:underline" href=route('course', { id: course.id }))= course.title
            td.px-4.py-2
              .flex.flex-wrap.items-center.gap-2
                a(class="rounded bg-blue-600 px-3 py-1 text-sm text-white hover:bg-blue-700" href=route('editCourse', { id: course.id })) Редактировать
                form(action=`${route('course', { id: course.id })}?_method=DELETE`, method="post")
                  input(class="cursor-pointer rounded bg-red-600 px-3 py-1 text-sm text-white hover:bg-red-700" type='submit', value="Удалить")
