extends ../layouts/index.pug

block header
  = "Новый курс"

block content
  .mx-auto.max-w-xl.rounded-lg.border.border-gray-200.bg-white.p-6.shadow-sm
    form(action=route('courses') method='post')
      .mb-4
        label.mb-1.block.text-sm.font-medium(for="title") Название
        input(class="w-full rounded border border-gray-300 px-3 py-2" id="title" name="title" value=title)

      .mb-4
        label.mb-1.block.text-sm.font-medium(for="description") Описание
        textarea(class="w-full rounded border border-gray-300 px-3 py-2" id="description" name="description" rows="4")= description

      input(class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type='submit' value='Создать')
