extends ../layouts/index.pug

block header
  = "Редактирование пользователя"

block content
  .mx-auto.max-w-xl.rounded-lg.border.border-gray-200.bg-white.p-6.shadow-sm
    form(action=`${route('user', { id: user.id })}?_method=PATCH` method='post')
      .mb-4
        label.mb-1.block.text-sm.font-medium(for="name") Имя
        input(class="w-full rounded border border-gray-300 px-3 py-2" id="name" name="name" value=user.name)

      .mb-4
        label.mb-1.block.text-sm.font-medium(for="email") Емейл
        input(class="w-full rounded border border-gray-300 px-3 py-2" id="email" name="email" value=user.email)

      .mb-4
        label.mb-1.block.text-sm.font-medium(for="password") Пароль
        input(class="w-full rounded border border-gray-300 px-3 py-2" id="password" name="password" type="password")

      .mb-4
        label.mb-1.block.text-sm.font-medium(for="passwordConfirmation") Подтверждение пароля
        input(class="w-full rounded border border-gray-300 px-3 py-2" id="passwordConfirmation" name="passwordConfirmation" type="password")

      input(class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type='submit' value='Сохранить')
