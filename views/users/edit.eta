<% layout("../layouts/index", { header: "Редактирование пользователя" }) %>
<div class="mx-auto max-w-xl rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <form action="<%= it.route('user', { id: it.user.id }) %>?_method=PATCH" method="post">
    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="name">Имя</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="name" name="name" value="<%= it.user.name %>">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="email">Емейл</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="email" name="email" value="<%= it.user.email %>">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="password">Пароль</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="password" name="password" type="password">
    </div>

    <div class="mb-4">
      <label class="mb-1 block text-sm font-medium" for="passwordConfirmation">Подтверждение пароля</label>
      <input class="w-full rounded border border-gray-300 px-3 py-2" id="passwordConfirmation" name="passwordConfirmation" type="password">
    </div>

    <input class="cursor-pointer rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type="submit" value="Сохранить">
  </form>
</div>
