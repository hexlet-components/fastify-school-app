extends ../layouts/index.pug

block header
  = "Список пользователей"

block content
  a(class="inline-block rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" href=route('newUser')) Новый пользователь

  .mt-8.overflow-x-auto
    table.w-full.border-collapse.bg-white.text-left
      thead
        tr.border-b.border-gray-200
          th.px-4.py-2.font-semibold Идентификатор
          th.px-4.py-2.font-semibold Имя
          th.px-4.py-2.font-semibold Емейл
          th.px-4.py-2.font-semibold Действия
      tbody
        each user in users
          tr(class="border-b border-gray-100 odd:bg-gray-50")
            td.px-4.py-2= user.id
            td.px-4.py-2= user.name
            td.px-4.py-2= user.email
            td.px-4.py-2
              .flex.flex-wrap.items-center.gap-2
                a(class="rounded bg-blue-600 px-3 py-1 text-sm text-white hover:bg-blue-700" href=route('editUser', { id: user.id })) Редактировать
                form(action=`${route('user', { id: user.id })}?_method=DELETE`, method="post")
                  input(class="cursor-pointer rounded bg-red-600 px-3 py-1 text-sm text-white hover:bg-red-700" type='submit', value="Удалить")
