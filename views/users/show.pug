extends ../layouts/index.pug

block header
  = user.name

block content
  .rounded-lg.border.border-gray-200.bg-white.p-6.shadow-sm
    dl
      .mb-3.flex.flex-wrap.gap-2
        dt.text-gray-500 Имя
        dd= user.name
      .mb-4.flex.flex-wrap.gap-2
        dt.text-gray-500 Емейл
        dd= user.email
    .flex.flex-wrap.items-center.gap-2
      a(class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" href=route('editUser', { id: user.id })) Редактировать
      form(action=`${route('user', { id: user.id })}?_method=DELETE`, method="post")
        input(class="cursor-pointer rounded bg-red-600 px-4 py-2 text-white hover:bg-red-700" type='submit', value="Удалить")
